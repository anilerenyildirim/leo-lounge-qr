---
/* ============================================================
   Ortak iskelet — leo-lounge.

   Menü sayfalarında (menu bayrağı):
     · <Splash>          — ilk girişte açılış ekranı (logo + yükleme)
     · .ambient          — hareketli çizgi dalgaları (scripts/waves.ts).
                           `transition:persist`: sayfalar arasında aynı
                           tuval yaşıyor, dalga sayfa değişince kesilmiyor,
                           WebGL bağlamı her sayfada yeniden kurulmuyor.
     · <dialog id="lb">  — büyük görünüm
     · app.ts            — büyük görünüm + eksik kare + geri tuşu

   `dim`: kategori sayfaları. Ürün listesi doğrudan zeminin üstünde
   durduğu için dalga orada kısılıyor (data-waves="dim", menu.css).
   Izgarada kartlar opak, dalga tam güçte kalabiliyor.

   Ana sayfa bunların hiçbirini yüklemiyor — SIFIR JavaScript.

   YAZI TİPLERİ
   · Cormorant Garamond — ürün adları, açıklamalar, gövde.
   · Josefin Sans (yalnız menü) — kategori etiketleri, başlıklar.
     Müşteri seçimi (11 Eylül, Deco); gerekçe menu.css → --font-label.
   ============================================================ */
import { ClientRouter } from 'astro:transitions';
import Splash from '../components/Splash.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  venue: 'cafe' | 'lounge';
  /** menü sayfası mı? açılış, dalga, büyük görünüm ve app.ts yalnız orada */
  menu?: boolean;
  /** dalgayı kıs — metin doğrudan zeminde duruyorsa */
  dim?: boolean;
}

const { title, description, venue, menu = false, dim = false } = Astro.props;
/* Menüde tarayıcı çubuğu antrasit zeminle aynı renk. */
const themeColor = menu ? '#15181B' : venue === 'lounge' ? '#0B0907' : '#FCFBF9';

const fonts = [
  'family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400',
  ...(menu ? ['family=Josefin+Sans:wght@300;400'] : []),
].join('&');
---

<!doctype html>
<html lang="tr" data-venue={venue} data-waves={menu ? (dim ? 'dim' : 'full') : undefined}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content={themeColor} />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href={`https://fonts.googleapis.com/css2?${fonts}&display=swap`} rel="stylesheet" />

  <ClientRouter />
</head>
<body>
  {menu && <Splash />}
  {menu && <div class="ambient" aria-hidden="true" transition:persist="ambient"></div>}

  <slot />

  {menu && (
    <dialog id="lb" aria-label="Ürün görseli">
      <div class="lb-in">
        <button class="lb-x" type="button" data-lb-close aria-label="Kapat"></button>

        <div class="lb-shot">
          <img id="lbImg" src="" alt="" />
        </div>

        <div class="lb-meta">
          <p class="lb-row">
            <span id="lbName" class="lb-name"></span>
            <span id="lbPrice" class="lb-price"></span>
          </p>
          <p id="lbDesc" class="lb-desc"></p>
        </div>

        <button class="lb-nav lb-prev" type="button" data-lb-prev aria-label="Önceki görsel"></button>
        <button class="lb-nav lb-next" type="button" data-lb-next aria-label="Sonraki görsel"></button>
      </div>
    </dialog>

    <script>
      import '../scripts/splash.ts';
      import '../scripts/app.ts';
      import '../scripts/waves.ts';
    </script>
  )}
</body>
</html>
