---
/* ============================================================
   Kategori kartı — /menu ızgarasının tek hücresi.

   YAZI SOLDA, GÖRSEL SAĞDA.
   Fotoğraf kartın sağ üçte ikisini kaplıyor ve SOLA DOĞRU kartın
   zeminine karışarak sönüyor (menu.css → .cat-media maskesi): yazının
   zemini kesintisiz biçimde fotoğrafa dönüşüyor, arada kenar yok.

   KART OPAK. Işığı arka plan veriyor, kart onun önünde düz bir levha.

   SAĞ YARI — öncelik sırasıyla (bkz. lib/menuCards.ts):
     1. fotoğraf   2. bardak ikonu (içecekler)   3. hiçbiri
   Üçüncü durum FOTOĞRAFSIZ KART: yalnız yazı. Yer tutucu yok —
   müşteri kararı (11 Eylül): fotoğrafı gelmemiş kategoride harf ya da
   boş kutu değil, sade kart. Fotoğraf CDN'e yüklendiği gün kendiliğinden
   gelir. Kare CDN'de yoksa app.ts görseli söküyor ve kart aynı
   fotoğrafsız hâle düşüyor — kırık ikon yok.

   Görsel DEKORATİF (aria-hidden, alt=""): erişilebilir ad kartın
   kendisinde.
   ============================================================ */
import { photoOf } from '../data/menu';
import { cardPhoto, cardSection, type MenuCard } from '../lib/menuCards';
import { iconSvg } from '../lib/icons';

interface Props {
  card: MenuCard;
  /** ızgaranın ilk kareleri önce yüklenir */
  eager?: boolean;
}

const { card, eager = false } = Astro.props;
const cover = cardPhoto(card);
const photo = cover ? photoOf(cover) : null;
const icon = !photo && card.icon ? iconSvg(card.icon) : null;
const count = cardSection(card).count;
---

<a
  class:list={['cat', card.wide && 'cat-wide', !photo && 'cat-noimg', icon && 'cat-hasicon']}
  href={`/menu/${card.key}/`}
>
  {/* HEPSİ EAGER: açılış ekranı "bütün kartlar yüklenene kadar"
      bekliyor (scripts/splash.ts). Lazy kare ekran dışında hiç
      başlamaz ve bekleme ya zaman aşımına düşer ya da eksik kalırdı.
      Yalnız 7 kare (~80 KB), bedeli küçük. `eager` artık yalnız
      öncelik veriyor. */}
  {photo && (
    <span class="cat-media" aria-hidden="true">
      <img
        src={photo.src}
        alt=""
        width={photo.w}
        height={photo.h}
        loading="eager"
        fetchpriority={eager ? 'high' : 'auto'}
        decoding="async"
      />
    </span>
  )}
  {icon && <span class="cat-icon" aria-hidden="true" set:html={icon} />}
  <span class="cat-body">
    <span class="cat-title">{card.title}</span>
    <span class="cat-count">{count} ürün</span>
  </span>
</a>
