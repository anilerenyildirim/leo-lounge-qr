---
/* ============================================================
   Fotoğraf kutusu.

   Yalnız dosyası GERÇEKTEN olan ürünler için basılır (menu.json'un
   `photo` alanı). Eksik dosya için <img> hiç üretilmez — 404 yok,
   konsol temiz, düzen sıçraması yok.

   Kaynakların tamamı 1200×800 (3:2) ve liste kutusu da 3:2; kırpma
   yok. Ölçü dosyanın kendisinden geliyor (üreteç webp başlığından
   okuyup menu.json'a yazdı), buraya sayı yazılmıyor — yarın kare bir
   kare gelirse `shot-sq` kendiliğinden devreye giriyor.

   `trigger`: kutu <button> olur, tıklanınca büyük görünüm açılır.
   O durumda img alt'ı BOŞ ve erişilebilir ad düğmede: aksi halde
   ekran okuyucu ürün adını iki kez okurdu.

   `eager`: ızgaranın ilk karesi için. Gerisi lazy.
   ============================================================ */
import { photoOf } from '../data/menu';

interface Props {
  slug: string;
  name: string;
  eager?: boolean;
  /** kutuyu tıklanabilir düğmeye çevir */
  trigger?: boolean;
  /** kart içinde görsel dekoratif: erişilebilir ad kartın kendisinde */
  decorative?: boolean;
  class?: string;
}

const {
  slug, name, eager = false, trigger = false, decorative = false, class: cls = '',
} = Astro.props;

const photo = photoOf(slug);
const square = photo !== null && photo.w === photo.h;

const Tag = trigger ? 'button' : 'div';
const extra = trigger
  ? { type: 'button' as const, 'data-lb': slug, 'aria-label': `${name} — görseli büyüt` }
  : {};
---

<Tag class:list={['shot', square && 'shot-sq', cls]} {...extra}>
  <img
    src={photo?.src}
    alt={trigger || decorative ? '' : name}
    width={photo?.w ?? 1200}
    height={photo?.h ?? 800}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    decoding="async"
  />
</Tag>
